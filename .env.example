# Browser-safe configuration only. Never put a service-role, Stripe secret, or
# maps secret in a NEXT_PUBLIC_ / EXPO_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A public map token with domain/bundle restrictions. Required before Live mode.
NEXT_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_KEY=

# Server / Supabase Edge Function secrets — set in the host or Supabase dashboard only.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAPBOX_DIRECTIONS_TOKEN=
TWK_APP_ORIGIN=http://localhost:3000

